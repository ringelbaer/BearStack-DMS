<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="photos_fast_scroll">Schnell durch die Liste scrollen</string>
    <string name="photos_selection_start">Mehrere Medien auswählen</string>
    <string name="photos_selection_close">Auswahl beenden</string>
    <!-- Position/count label has identical grammar for every quantity. -->
    <string name="photos_selection_count" tools:ignore="PluralsCandidate">%1$d / %2$d ausgewählt</string>
    <string name="photos_selection_save">Auswahl speichern</string>
    <plurals name="photos_selection_saved">
        <item quantity="one">%1$d Medium gespeichert</item>
        <item quantity="other">%1$d Medien gespeichert</item>
    </plurals>
    <string name="photos_delete">Löschen</string>
    <plurals name="photos_delete_confirm">
        <item quantity="one">%1$d Bild dauerhaft von diesem Gerät löschen? Diese Aktion lässt sich nicht rückgängig machen.</item>
        <item quantity="other">%1$d Bilder dauerhaft von diesem Gerät löschen? Diese Aktion lässt sich nicht rückgängig machen.</item>
    </plurals>
    <string name="photos_delete_error">Die Bilder konnten nicht vollständig gelöscht werden. Prüfe den Fotozugriff und versuche es erneut.</string>
</resources>
