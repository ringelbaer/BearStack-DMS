[Unit]
Description=BearStack Dokumentenserver
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/bearstack

[Service]
Type=simple
User=bearstack
Group=bearstack
Environment=BEARSTACK_CONFIG=/etc/bearstack/bearstack.json
ExecStart=/usr/local/bin/bearstack
WorkingDirectory=/var/lib/bearstack
Restart=on-failure
RestartSec=5s
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bearstack

# Wenn storage_dir oder db_path ausserhalb von /var/lib/bearstack liegen,
# diese Verzeichnisse bei RequiresMountsFor und ReadWritePaths ergaenzen.
# Beispiel:
# RequiresMountsFor=/var/lib/bearstack /srv/bearstack/documents
# ReadWritePaths=/srv/bearstack/documents

[Install]
WantedBy=multi-user.target
